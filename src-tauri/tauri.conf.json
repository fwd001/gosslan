{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gosslan",
  "version": "0.4.1",
  "identifier": "com.gosslan.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gosslan",
        "width": 1200,
        "height": 780,
        "minWidth": 920,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "SocialNetworking",
    "shortDescription": "无服务器 P2P 局域网即时通讯",
    "longDescription": "Gosslan 是一款无中央服务器的 P2P 局域网即时通讯工具，支持设备发现、好友、群聊、文件传输与共享目录。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
