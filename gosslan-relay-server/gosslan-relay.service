# Gosslan 公网中转（哑管道）—— systemd 单元
#
# 安装：
#   1. 把 server.mjs 放到 /opt/gosslan-relay/server.mjs
#   2. 口令单独放文件（不要写进本单元，`systemctl show` 会把它露出来）：
#        printf 'TOKEN=%s\n' "$(openssl rand -hex 16)" | sudo tee /etc/gosslan-relay.env
#        sudo chmod 600 /etc/gosslan-relay.env
#   3. 复制本文件到 /etc/systemd/system/gosslan-relay.service
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now gosslan-relay
#   5. 放行端口：sudo firewall-cmd --add-port=59993/tcp --permanent && sudo firewall-cmd --reload
#      （或 ufw：sudo ufw allow 59993/tcp）
#
# 这个单元按"公网上长期跑"的标准收紧：动态用户、只读根文件系统、禁 exec/execve 之外的
# 大部分系统调用、内存与 CPU 上限（哑管道搬字节用不了多少，超了就是出 bug 了）。

[Unit]
Description=Gosslan blind circuit relay (no payload parsing, no storage)
Documentation=https://github.com/fwd001/gosslan-relay-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/env node /opt/gosslan-relay/server.mjs
EnvironmentFile=/etc/gosslan-relay.env
Environment=PORT=59993
Environment=HOST=0.0.0.0

DynamicUser=yes
SupplementaryGroups=
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/gosslan-relay
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes

# 只留这一个进程该做的事：TCP 收发 + 内存分配。
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @reboot @swap @keyring @module @aio @cpu-emergency @obsolete
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=

# 端口 <1024 不需要，但 59993 也不需要任何 capability；显式限制并发与内存兜底。
LimitNOFILE=4096
MemoryHigh=128M
MemoryMax=192M
CPUQuota=50%

Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gosslan-relay

[Install]
WantedBy=multi-user.target
